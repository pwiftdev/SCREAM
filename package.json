{
  "name": "lets-scream-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n game,server 'vite --host 127.0.0.1' 'tsx watch server/index.ts'",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsup",
    "start": "node dist-server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "lint": "eslint src shared server tests",
    "check": "npm run typecheck && npm run lint && npm test && prettier --check src shared server tests docs scripts public/audio *.json *.ts *.js README.md index.html",
    "heroku-postbuild": "npm run build",
    "test:e2e": "npm run build && tsx scripts/test-browser-local.ts",
    "assets": "tsx scripts/export-characters.ts",
    "assets:download": "node scripts/download-environment.mjs && python3 scripts/download-characters.py && python3 scripts/download-killer.py",
    "assets:environment": "tsx scripts/prepare-environment.ts",
    "assets:killer": "node scripts/export-killer.mjs",
    "assets:portraits": "node scripts/export-portraits.mjs",
    "assets:audio": "node scripts/prepare-audio.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@fontsource/anton": "^5.2.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/silkscreen": "^5.2.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/wallet-standard-wallet-adapter-base": "^1.1.7",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "^1.1.1",
    "bs58": "^6.0.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "postprocessing": "^6.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "esbuild": "0.28.2",
    "shell-quote": "1.11.0",
    "jayson": "5.0.0"
  },
  "engines": {
    "node": "26.x"
  }
}
