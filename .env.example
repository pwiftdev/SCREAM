# Local defaults. No cloud resources, paid APIs, rewards or real-money transfers.
PORT=2567
# Set to the exact HTTPS app origin on Heroku.
PUBLIC_ORIGIN=
ALLOW_GUEST_PROFILES=false
# Heroku Postgres uses provider-managed certificates; leave blank for local Postgres.
DATABASE_SSL=
REWARDS_MODE=off
# Optional local Postgres. Without this, data/scream.sqlite stores profiles and points.
# DATABASE_URL=postgres://localhost/scream_local
# Static assets default to /assets. Leave empty for local files.
ASSET_BASE_URL=
TOKEN_MINT=
HOLDER_MIN_BALANCE=100000
ALLOW_EXTERNAL_DATA=false
SOLANA_RPC_URL=
# Only set behind a deliberately configured, trusted proxy.
TRUST_PROXY=0
# Optional provider key, used only when ALLOW_EXTERNAL_DATA=true. Leave empty locally.
MOBULA_API_KEY=
# Deferred reward configuration. Keep mode off during local review.
# test simulates payments in Postgres without a wallet or RPC. live requires external access.
NIGHTLY_REWARD_LAMPORTS=0
# Server-only JSON byte array. Leave empty; never use a VITE_ variable for this.
HOUSE_SECRET_KEY=
# Hollow Lane: off by default; test uses pretend SQL balances. live is disabled.
ECONOMY_MODE=off
# Comma-separated public wallet addresses allowed to use /admin.
ADMIN_WALLETS=
